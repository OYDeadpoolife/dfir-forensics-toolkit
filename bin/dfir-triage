#!/usr/bin/env bash
# dfir-triage - read-only first-pass forensic triage of one evidence file.
#
# Takes ONE authorised evidence file, proves it is not changed (SHA-256 before and after),
# collects metadata and strings, optionally runs binwalk, foremost, bulk_extractor and
# Volatility 3 when they are installed, and writes everything into a new case directory
# together with a Markdown case report. Run "dfir-triage --help" for usage.
#
# Safety rules: the evidence is only read; nothing is installed; no root or sudo is used;
# existing cases are never overwritten; missing programs are reported, not "fixed".
#
# Error handling: "set -e" is deliberately not used. Every step that can fail is checked
# explicitly, and a failing module is recorded without stopping the others.
set -u
set -o pipefail
umask 077 # case directories can hold sensitive material: readable by the owner only

resolve_script_dir() {
    local source=${BASH_SOURCE[0]} dir
    while [[ -L $source ]]; do
        dir=$(cd -P -- "$(dirname -- "$source")" && pwd) || exit 1
        source=$(readlink "$source")
        if [[ $source != /* ]]; then
            source=$dir/$source
        fi
    done
    cd -P -- "$(dirname -- "$source")" && pwd
}

DFIR_ROOT=$(cd -- "$(resolve_script_dir)/.." && pwd) || exit 1
# shellcheck source=lib/dfir_common.sh
source "$DFIR_ROOT/lib/dfir_common.sh"
# shellcheck source=lib/dfir_validate.sh
source "$DFIR_ROOT/lib/dfir_validate.sh"
# shellcheck source=lib/dfir_hash.sh
source "$DFIR_ROOT/lib/dfir_hash.sh"
# shellcheck source=lib/dfir_modules.sh
source "$DFIR_ROOT/lib/dfir_modules.sh"
# shellcheck source=lib/dfir_report.sh
source "$DFIR_ROOT/lib/dfir_report.sh"

usage() {
    cat <<EOF
dfir-triage $DFIR_VERSION - read-only forensic triage of one evidence file

USAGE
  dfir-triage --evidence FILE [options]
  dfir-triage --list-modules
  dfir-triage --help | --version

OPTIONS
  -e, --evidence FILE       The evidence file to examine. It is only ever read.
  -o, --output-dir DIR      Where cases are created (default: ./dfir-cases).
  -c, --case-id ID          Name of the case folder, 1-64 of A-Z a-z 0-9 . _ - (default: CASE-<UTC time>).
                            An existing case folder is never overwritten.
  -a, --analyst NAME        Analyst name for the report (default: environment variable DFIR_ANALYST).
  -m, --modules LIST        Comma-separated modules or "auto" (default). Modules:
                            metadata, strings, binwalk, foremost, bulk_extractor, volatility.
                            "auto" runs all except volatility. A module whose program is not
                            installed is recorded as SKIPPED.
      --timeout SECONDS     Time limit for each external program, 0 = none (default: 1800).
      --strings-limit-mb N  Scan at most the first N MB for strings (default: 256).
      --strings-min-length N  Shortest string to keep (default: 6).
      --vol-plugins LIST    Volatility 3 plugins, comma or space separated
                            (default: windows.info.Info windows.pslist.PsList windows.pstree.PsTree
                            windows.cmdline.CmdLine windows.netscan.NetScan).
      --md5                 Also record an MD5 hash (legacy; SHA-256 is the integrity hash).
      --copy-evidence       Work on a read-only copy inside the case folder (needs disk space).
      --dry-run             Check everything and print the plan; create and write nothing.
      --list-modules        Show which modules can run on this machine, then exit.
  -q, --quiet               Print only warnings, errors and the final summary.
      --no-color            Never use colours (NO_COLOR is honoured too).
  -h, --help                Show this help.
      --version             Show the version.

EXIT STATUS
  $EXIT_OK  success                $EXIT_USAGE  invalid options            $EXIT_EVIDENCE  evidence problem
  $EXIT_RUNTIME  runtime failure         $EXIT_MODULE_ERRORS  a module failed or timed out
  $EXIT_INTEGRITY  the evidence hash CHANGED during the run - do not trust the results

EXAMPLES
  dfir-triage --evidence demo-case/evidence/ws01_triage_synthetic.bin --case-id CASE-DEMO-001
  dfir-triage -e image.raw -c CASE-2026-014 -a "Your Name" --modules metadata,strings,volatility
  dfir-triage -e image.raw --dry-run
EOF
}

# Defaults and option parsing ---------------------------------------------------------------

OPT_EVIDENCE=""
OPT_OUTPUT_DIR=./dfir-cases
OPT_CASE_ID=""
OPT_ANALYST=${DFIR_ANALYST:-}
OPT_MODULES=auto
OPT_COLOR=auto
OPT_DRY_RUN=0
OPT_LIST_MODULES=0
OPT_MD5=0
OPT_COPY_EVIDENCE=0
TIMEOUT_SECONDS=1800
STRINGS_LIMIT_MB=256
STRINGS_MIN_LENGTH=6
VOL_PLUGINS=$DEFAULT_VOL_PLUGINS

require_value() {
    # require_value OPTION "$@" : the option needs a following value
    if [[ $# -lt 2 || -z $2 ]]; then
        die "$EXIT_USAGE" "option $1 needs a value (see --help)"
    fi
}

parse_options() {
    while [[ $# -gt 0 ]]; do
        case $1 in
            -e | --evidence)
                require_value "$@"
                OPT_EVIDENCE=$2
                shift 2
                ;;
            -o | --output-dir)
                require_value "$@"
                OPT_OUTPUT_DIR=$2
                shift 2
                ;;
            -c | --case-id)
                require_value "$@"
                OPT_CASE_ID=$2
                shift 2
                ;;
            -a | --analyst)
                require_value "$@"
                OPT_ANALYST=$2
                shift 2
                ;;
            -m | --modules)
                require_value "$@"
                OPT_MODULES=$2
                shift 2
                ;;
            --timeout)
                require_value "$@"
                TIMEOUT_SECONDS=$2
                shift 2
                ;;
            --strings-limit-mb)
                require_value "$@"
                STRINGS_LIMIT_MB=$2
                shift 2
                ;;
            --strings-min-length)
                require_value "$@"
                STRINGS_MIN_LENGTH=$2
                shift 2
                ;;
            --vol-plugins)
                require_value "$@"
                VOL_PLUGINS=${2//,/ }
                shift 2
                ;;
            --md5)
                OPT_MD5=1
                shift
                ;;
            --copy-evidence)
                OPT_COPY_EVIDENCE=1
                shift
                ;;
            --dry-run)
                OPT_DRY_RUN=1
                shift
                ;;
            --list-modules)
                OPT_LIST_MODULES=1
                shift
                ;;
            -q | --quiet)
                OPT_QUIET=1
                shift
                ;;
            --no-color)
                OPT_COLOR=never
                shift
                ;;
            -h | --help)
                usage
                exit "$EXIT_OK"
                ;;
            --version)
                printf 'dfir-triage %s\n' "$DFIR_VERSION"
                exit "$EXIT_OK"
                ;;
            *)
                die "$EXIT_USAGE" "unknown option or argument: $1 (see --help)"
                ;;
        esac
    done
}

validate_options() {
    local plugin
    require_integer "--timeout" "$TIMEOUT_SECONDS" 0 604800
    require_integer "--strings-limit-mb" "$STRINGS_LIMIT_MB" 1 1048576
    require_integer "--strings-min-length" "$STRINGS_MIN_LENGTH" 3 1000
    parse_module_list "$OPT_MODULES"
    # Plugin names become command arguments and file names, so only safe characters are allowed.
    for plugin in $VOL_PLUGINS; do
        if [[ ! $plugin =~ ^[A-Za-z0-9_.]+$ ]]; then
            die "$EXIT_USAGE" "invalid Volatility plugin name: $plugin"
        fi
    done
    if [[ -z $OPT_CASE_ID ]]; then
        OPT_CASE_ID=CASE-$(date -u +%Y%m%d-%H%M%S)
    fi
    validate_case_id "$OPT_CASE_ID"
    CASE_ID=$OPT_CASE_ID
    ANALYST=$(one_line "${OPT_ANALYST:-not specified}")
    if [[ ${#ANALYST} -gt 80 ]]; then
        die "$EXIT_USAGE" "--analyst is longer than 80 characters"
    fi
}

# Dry run -------------------------------------------------------------------------------------

print_dry_run_plan() {
    local module
    printf 'dfir-triage: dry run - nothing is created or written, the evidence is not read.\n'
    printf '  Case ID      : %s\n' "$CASE_ID"
    printf '  Case folder  : %s (would be created)\n' "$CASE_DIR"
    printf '  Evidence     : %s (%s bytes; only read, never modified)\n' "$EVIDENCE_PATH" "$(size_of "$EVIDENCE_PATH")"
    printf '  Analyst      : %s\n' "$ANALYST"
    printf '  Time limit   : %s seconds per external program (0 = none)\n' "$TIMEOUT_SECONDS"
    printf '  Modules      :\n'
    for module in "${MODULES[@]}"; do
        printf '    %s\n' "$(describe_module "$module")"
    done
    printf '  Steps        : record file times, SHA-256 before, modules above, SHA-256 after, integrity check, case report\n'
}

# Main flow -----------------------------------------------------------------------------------

create_case_directory() {
    mkdir -p "$CASE_DIR/metadata" "$CASE_DIR/logs" "$CASE_DIR/hashes" "$CASE_DIR/report" ||
        die "$EXIT_RUNTIME" "cannot create the case directory: $CASE_DIR"
    RUN_LOG=$CASE_DIR/logs/run.log
    STATUS_FILE=$CASE_DIR/logs/status.tsv
    COMMANDS_FILE=$CASE_DIR/logs/commands.txt
    VERSIONS_FILE=$CASE_DIR/logs/tool_versions.tsv
    CUSTODY_FILE=$CASE_DIR/logs/custody.tsv
    : >"$RUN_LOG"
    : >"$COMMANDS_FILE"
    : >"$VERSIONS_FILE"
    printf 'module\tstatus\texit_code\tstarted_utc\tfinished_utc\tnote\n' >"$STATUS_FILE"
    printf 'time_utc\tevent\tdetail\n' >"$CUSTODY_FILE"
}

custody() {
    printf '%s\t%s\t%s\n' "$(utc_now)" "$1" "$(one_line "$2")" >>"$CUSTODY_FILE"
}

write_case_info() {
    {
        printf 'case_id=%s\n' "$CASE_ID"
        printf 'analyst=%s\n' "$ANALYST"
        printf 'tool=dfir-triage %s\n' "$DFIR_VERSION"
        printf 'started_utc=%s\n' "$STARTED_AT"
        printf 'evidence_path=%s\n' "$(one_line "$EVIDENCE_PATH")"
        printf 'system=%s\n' "$(uname -sr)"
        printf 'command_line=%s\n' "$(one_line "$COMMAND_LINE")"
    } >"$CASE_DIR/case_info.txt"
}

# Hash the evidence before any tool touches it.
hash_evidence_before() {
    log_info "hashing the evidence (SHA-256) ..."
    SHA256_BEFORE=$(sha256_of "$EVIDENCE_PATH") || die "$EXIT_EVIDENCE" "could not hash the evidence file"
    write_hash_file "$SHA256_BEFORE" "$EVIDENCE_NAME" "$CASE_DIR/hashes/evidence.sha256"
    custody EVIDENCE_HASHED_BEFORE "sha256=$SHA256_BEFORE size=$EVIDENCE_SIZE"
    MD5_VALUE=""
    if ((OPT_MD5)); then
        MD5_VALUE=$(md5_of "$EVIDENCE_PATH") || die "$EXIT_RUNTIME" "--md5 was requested but no MD5 tool was found"
        write_hash_file "$MD5_VALUE" "$EVIDENCE_NAME" "$CASE_DIR/hashes/evidence.md5"
    fi
}

# Optionally analyse a read-only copy. The copy is verified against the original hash.
make_working_copy() {
    local copy_hash
    mkdir -p "$CASE_DIR/evidence"
    cp -- "$EVIDENCE_PATH" "$CASE_DIR/evidence/$EVIDENCE_NAME" || die "$EXIT_RUNTIME" "could not copy the evidence"
    chmod 400 "$CASE_DIR/evidence/$EVIDENCE_NAME"
    copy_hash=$(sha256_of "$CASE_DIR/evidence/$EVIDENCE_NAME") || die "$EXIT_RUNTIME" "could not hash the evidence copy"
    if [[ $copy_hash != "$SHA256_BEFORE" ]]; then
        die "$EXIT_INTEGRITY" "the evidence copy does not match the original hash"
    fi
    WORK_EVIDENCE=$CASE_DIR/evidence/$EVIDENCE_NAME
    custody EVIDENCE_COPIED "working copy verified: $WORK_EVIDENCE"
}

# Hash the original again and compare. A mismatch means something changed the evidence.
verify_integrity() {
    SHA256_AFTER=$(sha256_of "$EVIDENCE_PATH") || SHA256_AFTER="unavailable"
    write_hash_file "$SHA256_AFTER" "$EVIDENCE_NAME" "$CASE_DIR/hashes/evidence.after.sha256"
    if [[ $SHA256_AFTER == "$SHA256_BEFORE" ]]; then
        INTEGRITY_RESULT="VERIFIED - evidence unchanged"
        custody INTEGRITY_VERIFIED "sha256 identical before and after"
    else
        INTEGRITY_RESULT="FAILED - evidence changed during analysis"
        custody INTEGRITY_FAILED "before=$SHA256_BEFORE after=$SHA256_AFTER"
        log_error "the evidence hash changed during the run"
    fi
}

print_final_summary() {
    local green="" red="" yellow="" reset="" module status line color
    if ((USE_COLOR_STDOUT)); then
        green="${ESC}[1;32m"
        red="${ESC}[1;31m"
        yellow="${ESC}[1;33m"
        reset="${ESC}[0m"
    fi
    printf '\ndfir-triage %s - case %s finished\n' "$DFIR_VERSION" "$CASE_ID"
    printf '  Evidence : %s (%s bytes)\n' "$EVIDENCE_NAME" "$EVIDENCE_SIZE"
    printf '  SHA-256  : %s\n' "$SHA256_BEFORE"
    if [[ $INTEGRITY_RESULT == VERIFIED* ]]; then
        printf '  Integrity: %s%s%s\n' "$green" "$INTEGRITY_RESULT" "$reset"
    else
        printf '  Integrity: %s%s%s\n' "$red" "$INTEGRITY_RESULT" "$reset"
    fi
    printf '  Modules  :\n'
    while IFS=$'\t' read -r module status _; do
        case $status in
            OK) color=$green ;;
            SKIPPED) color=$yellow ;;
            *) color=$red ;;
        esac
        line=$(printf '%s%s%s' "$color" "$status" "$reset")
        printf '    %-15s %s\n' "$module" "$line"
    done < <(tail -n +2 "$STATUS_FILE")
    printf '  Report   : %s\n' "$CASE_DIR/report/case_report.md"
}

main() {
    if [[ $# -eq 0 ]]; then
        usage >&2
        exit "$EXIT_USAGE"
    fi
    COMMAND_LINE=$(quote_command dfir-triage "$@")
    parse_options "$@"
    init_color "$OPT_COLOR"

    if ((OPT_LIST_MODULES)); then
        local name
        for name in $ALL_MODULES; do
            describe_module "$name"
        done
        exit "$EXIT_OK"
    fi

    validate_options
    validate_evidence_file "$OPT_EVIDENCE"
    validate_output_dir "$OPT_OUTPUT_DIR" "$CASE_ID"
    EVIDENCE_SIZE=$(size_of "$EVIDENCE_PATH")
    if ((OPT_DRY_RUN)); then
        print_dry_run_plan
        exit "$EXIT_OK"
    fi

    create_case_directory
    STARTED_AT=$(utc_now)
    WORK_EVIDENCE=$EVIDENCE_PATH
    write_case_info
    custody CASE_OPENED "case $CASE_ID, analyst $ANALYST"
    log_info "case $CASE_ID created in $CASE_DIR"

    capture_file_attributes "$CASE_DIR/metadata/file_attributes.txt"
    hash_evidence_before
    if ((OPT_COPY_EVIDENCE)); then
        make_working_copy
    fi

    run_modules

    verify_integrity
    FINISHED_AT=$(utc_now)
    write_case_report
    custody REPORT_WRITTEN "report/case_report.md"
    print_final_summary

    if [[ $INTEGRITY_RESULT != VERIFIED* ]]; then
        exit "$EXIT_INTEGRITY"
    fi
    if tail -n +2 "$STATUS_FILE" | awk -F '\t' '$2 == "FAILED" || $2 == "TIMEOUT" { found = 1 } END { exit !found }'; then
        exit "$EXIT_MODULE_ERRORS"
    fi
    exit "$EXIT_OK"
}

main "$@"
